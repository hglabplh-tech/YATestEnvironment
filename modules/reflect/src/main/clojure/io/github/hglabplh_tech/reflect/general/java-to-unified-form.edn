;; Actual outcomes of the supplied Clojure readers -> unified IR.
#:mapping{:known-boundaries
          ["The main output uses :reflect-data {:structured-class ...}; it is not the compatibility :class-data shape."
           "Interface definitions use :normal-class plus :attr-interface, not a native :interface-class wrapper."
           "Exceptions declared in :exception-types are class/type values, not exception instances. No runtime error trace is emitted."
           "Records have no authoritative component-order list in these custom maps. Keep field candidates and raw constructor type vectors; do not zip them into invented ordered components."
           "Nested enum/record branch names may be absent. Do not use their containing class name as their own identity."
           "The :annot-class branch can fail upstream due to Class passed to an Annotation-instance helper; no successful declaration payload is claimed."
           "No Jakarta semantic-constraint catalog is added: this correction maps emitted annotations as data. A later semantic layer may interpret them."
           "Legacy annotation transforms can lose enum selection/default-member association or stringify arrays. Additional annotation discovery is not silently used to repair missing output."
           "The switch helper reports heuristic raw byte matches; do not promote them to verified switch instruction counts or source branches."
           "This catalog defines logical unified target paths and may require extensions to your AST grammar."],
          :entry :java/reflection-result,
          :catalog-id :java/generated-output-to-unified,
          :native-prefixes
          [#:native{:object-kind :class, :prefix "cls-"}
           #:native{:object-kind :interface, :prefix "ifc-"}
           #:native{:object-kind :constructor, :prefix "ctor-"}
           #:native{:object-kind :field, :prefix "fld-"}
           #:native{:object-kind :method, :prefix "meth-"}
           #:native{:object-kind :annotation, :prefix "annot-"}
           #:native{:object-kind :annotation-policy, :prefix "annot-policy-"}
           #:native{:object-kind :record, :prefix "rec-"}
           #:native{:object-kind :free-name, :prefix "name-"}
           #:native{:object-kind :free-value, :prefix "val-"}
           #:native{:object-kind :free-type, :prefix "typename-"}
           #:native{:object-kind :none, :prefix ""}],
          :operations
          [#:operation{:id :annotation-policy,
                       :description
                       "Normalize Target/Retention enum values from authoritative live metadata or unambiguous native values; retain exact native policy keywords."}
           #:operation{:id :canonical-to-qualified-name,
                       :description
                       "Preserve the canonical source name as a qualified name. Do not assume it is a JVM binary name."}
           #:operation{:id :class-id-from-output,
                       :description
                       "Build declaration identity from emitted class-name plus optional output-source identity domain. Do not require a separately loaded Class; canonical name remains distinct from JVM binary name."}
           #:operation{:id :constant,
                       :description "Write the literal :value, including discriminator constants."}
           #:operation{:id :copy,
                       :description
                       "Copy a known EDN-safe value. Omitted input remains omitted; nil is copied only when valid for that destination."}
           #:operation{:id :decode-annotation-default,
                       :description
                       "Treat :val-* and :typename-* as default-value metadata; member association is unavailable unless live annotation declaration provides it. Preserve native key and payload."}
           #:operation{:id :decode-class-flags,
                       :description
                       "Interpret :attr-* flags according to :java/class-attributes; :attr-interface selects contract rather than class. Sealed child completeness is not implied."}
           #:operation{:id :decode-constructor-flags,
                       :description "Read :attr-varargs and :attr-synthetic."}
           #:operation{:id :decode-constructor-modifiers,
                       :description
                       "Decode visibility in CONSTRUCTOR context; do not invent method-only modifiers."}
           #:operation{:id :decode-field-flags,
                       :description "Read :attr-enum-const and :attr-synthetic."}
           #:operation{:id :decode-field-modifiers,
                       :description
                       "Decode visibility, static, final, transient and volatile in FIELD context. Final means ordinary binding writes are prohibited, not deep immutability."}
           #:operation{:id :decode-method-flags,
                       :description
                       "Read :attr-varargs/:attr-synthetic/:attr-default/:attr-bridge. Use flags for the proper JVM facts; retain all native values."}
           #:operation{:id :decode-method-modifiers,
                       :description
                       "Decode visibility, abstract/final/static/native/synchronized/strict by METHOD context. Ignore :transient/:volatile as source method modifiers: their bits overlap varargs/bridge."}
           #:operation{:id :decode-output-modifier-integer,
                       :description
                       "Interpret an emitted modifier integer using supplied method/constructor/field/class context; preserve raw integer and context-sensitive flags."}
           #:operation{:id :decode-parameter-flags,
                       :description
                       "Read :vararg/:implicit/:name-present/:synthetic. Source name is trusted only when :name-present is set."}
           #:operation{:id :decode-parameter-modifiers,
                       :description
                       "Interpret the native modifier string in parameter context. Never infer source-only final from absent runtime metadata."}
           #:operation{:id :dispatch-class,
                       :description
                       "Select a class-wrapper branch by native keys; when nil, empty or unavailable emit availability evidence instead of inventing a declaration."}
           #:operation{:id :dispatch-type,
                       :description
                       "Dispatch live java.lang.reflect.Type/AnnotatedType first, then recognized native map shapes and scoped names; never infer lost generic arguments from erasure."}
           #:operation{:id :emit-interfaces,
                       :description
                       "Emit interface relationships and declarations/references, resolving generic counterparts by raw identity. Interface declaration nesting is not inheritance ownership."}
           #:operation{:id :emit-nested-declarations,
                       :description
                       "Traverse :pinner-classes as nested declarations, not subclasses. Carry owner identity. Anonymous enum/record payloads need corresponding live Class or explicit identity evidence; never use encounter index as stable identity."}
           #:operation{:id :emit-supertype,
                       :description
                       "Emit one normalized supertype relationship with the supplied role; preserve generic type separately from traversed class declaration."}
           #:operation{:id :emit-type-parameters,
                       :description
                       "Emit scoped type-parameter definitions only from declaration/TypeVariable structures already reachable in the supplied output. Deduplicate by declaring scope and name. Do not query a separately obtained Executable."}
           #:operation{:id :entry-key-name,
                       :description
                       "Read the entry key carried in context as a name, preserving the native key separately; string enum keys and keyword record-field keys are different native representations."}
           #:operation{:id :enum-identity-from-output,
                       :description
                       "Decode a class descriptor already present in case entries, or use root-class-name for a root enum. Never inherit a containing class name as the nested enum name."}
           #:operation{:id :executable-id-from-output,
                       :description
                       "Use emitted owner context, executable name, parameter erased types and return erased type to build overload-safe identity. Constructor name is <init>. Missing types require a provisional source-path ID and explicit incompleteness."}
           #:operation{:id :freeze-native,
                       :description
                       "Recursively retain the original native keys, strings, casing and nesting. Convert live values to typed EDN descriptors or explicit registry references, never opaque printed strings."}
           #:operation{:id :functional-shape,
                       :description
                       "Preserve a functional-interface/lambda observation with source and confidence. Heuristic flags do not prove a source lambda or a complete functional-interface classification."}
           #:operation{:id :join-parameter-annotations,
                       :description
                       "Attach outer :param-annots[index] to parameter[index] inside the signature; merge with parameter-local annotations and preserve source provenance without duplication."}
           #:operation{:id :join-switch-method,
                       :description
                       "Join switch evidence by owner+descriptor+methodName. Do not trust reflected signature enrichment joined only by method name when overloads exist."}
           #:operation{:id :map-node,
                       :description
                       "Apply :mapping/ref once to the selected value and append the resulting node."}
           #:operation{:id :map-nodes,
                       :description
                       "Apply :mapping/ref to each sequence item in input order, carrying index and owner context. Append nodes; do not replace existing children."}
           #:operation{:id :map-package-results,
                       :description
                       "Traverse the actual sequence-of-Class-vectors. Preserve grouping and emit class references through the package-class-reference mapping. No package-name input field exists."}
           #:operation{:id :merge-parameter-generics,
                       :description
                       "Enrich existing positional parameter types by index, preferring live annotated/generic types. nil/{} or N/A are unavailable, not new type declarations. Do not emit extra parameters."}
           #:operation{:id :normalize-annotation-values,
                       :description
                       "Read actual live annotation member values where available. Use :meth-* transformed values only when their actual-value semantics are intact. Enum specifications and :val-* defaults are not actual enum member selections."}
           #:operation{:id :normalize-annotations,
                       :description
                       "Normalize Annotation objects already in output or :annot-* wrapper maps. Preserve target, source provenance and native payload. No separate class annotation lookup or automatic enforcement claim."}
           #:operation{:id :normalize-bounds,
                       :description
                       "Normalize all upper bounds in order; do not infer numeric ranges from a bound such as Integer."}
           #:operation{:id :normalize-generic-declaration,
                       :description
                       "Normalize declaration owner identity and associated scoped type variables. Avoid expanding recursive generic declarations infinitely."}
           #:operation{:id :normalize-legacy-value,
                       :description
                       "Preserve legacy transformed payloads. Strings representing arrays are not reversible arrays; enum-spec maps do not identify a selected enum constant. Mark ambiguity."}
           #:operation{:id :normalize-output-annotation-object,
                       :description
                       "Normalize an Annotation object already present in the output, including its actual own member values. No separate class annotation discovery; no parsing of annotation toString."}
           #:operation{:id :normalize-output-class-reference,
                       :description
                       "Read name/package/type identity from the supplied Class and emit a reference, not an invented declaration body."}
           #:operation{:id :normalize-output-type-object,
                       :description
                       "Recursively normalize a Type, Class or AnnotatedType already present in the output, including nested type-use annotations. Access that object's type structure only; do not reload classes or fetch additional members."}
           #:operation{:id :normalize-return,
                       :description
                       "Use live AnnotatedType.getType() or generic-return Type first, usable :gen-return-type next, erased :return-type last; preserve type-use annotations at every nested type level when available."}
           #:operation{:id :normalize-throws,
                       :description
                       "Normalize each declared throwable Type to a declared-exception relationship; do not confuse declarations with runtime thrown instances or guaranteed behavior."}
           #:operation{:id :normalize-type,
                       :description
                       "Normalize Type/Class/AnnotatedType objects already carried in output; otherwise dispatch recognized native maps and scoped retained names. No Class/forName or member rediscovery. Preserve unresolved types as partial/unknown."}
           #:operation{:id :normalize-type-string,
                       :description
                       "Parse a retained type name with scope-aware generic/array/wildcard rules, or preserve it as an unresolved named reference. Do not guess that a short name is a type variable."}
           #:operation{:id :ordered-enum-cases,
                       :description
                       "Traverse native string-keyed case entries sorted by :ordinal; string keys remain native string keys. Drop the :cls-e-info-empty sentinel."}
           #:operation{:id :provisional-record-id,
                       :description
                       "Use root-class-name only when the record is the root. Otherwise build an explicitly provisional extraction-local identifier from the native source path and owner. It is not a recovered stable class name."}
           #:operation{:id :record-field-candidates,
                       :description
                       "Traverse record payload entries except :ctorParmType and :methods as field candidates. Field maps may include static fields and are not authoritative record-component lists."}
           #:operation{:id :record-method-entries,
                       :description
                       "Traverse :methods entries with indexed keyword keys. Preserve the exact key and parse only its terminal method-name hint; require signature or live Method for stable overload identity."}
           #:operation{:id :resolve-class-reference,
                       :description
                       "Create a reference for :class-already-reflected. UnknownClass/N/A are missing-information sentinels rather than actual class names."}
           #:operation{:id :select-normal-class-mapping,
                       :description
                       "If emitted :attributes includes :attr-interface select :java/interface; otherwise use :java/class. No new class query."}
           #:operation{:id :simple-class-name,
                       :description
                       "Derive a simple name from an authoritative Class if available, otherwise from the supplied canonical name with an explicit derivation marker."}
           #:operation{:id :source-parameter-name,
                       :description
                       "Copy :param-name to source :element/name only if the sibling :param-flags contains :name-present; always preserve the reflected name in JVM metadata."}
           #:operation{:id :strip-known-prefix,
                       :description
                       "Remove exactly the declared native keyword prefix. No automatic case conversion or invented kebab-case conversion."}
           #:operation{:id :switch-observation,
                       :description
                       "Keep switch byte-scan observations as heuristic JVM evidence. Current scanner counts raw 0xAA/0xAB bytes without decoding instruction boundaries; counts may include operands. It cannot recover source cases or distinguish switch statements from expressions."}],
          :input-policy
          ["Only supplied output values and context derived during traversal are inputs."
           "No Class/forName, source re-reading, constructor invocation or additional declaration discovery is required."
           "Live Type/AnnotatedType/Annotation/Class values already carried by reader output can be normalized before EDN printing."
           "Lost information remains unavailable. Printed #object descriptions cannot restore objects."
           "All native :from tags retain their exact spellings, casing and dynamic-key types."],
          :version "2.0.0",
          :catalog
          [#:mapping{:id :java/reflection-result,
                     :input #:input{:kind :map},
                     :rules
                     [{:from [:language], :operation :copy, :to [:ast/language]}
                      {:from [:class-name], :operation :copy, :to [:context/root-class-name]}
                      {:from [:reflect-data :structured-class],
                       :operation :dispatch-class,
                       :to [:ast/root],
                       :mapping/ref :java/class-wrapper}
                      {:from [],
                       :operation :freeze-native,
                       :to [:ast/native :java :reader-output]}],
                     :source "java_reflector.clj/get-structured-meta-data",
                     :notes
                     ["This exact wrapper is returned by java-reflector/get-structured-meta-data. Do not pass the compatibility :class-data representation here. Context root-class-name applies to this root only, not automatically to unnamed nested records."]}
           #:mapping{:id :java/class-wrapper,
                     :input #:input{:kind :map},
                     :rules
                     [{:from [:normal-class],
                       :operation :select-normal-class-mapping,
                       :to [],
                       :when {:condition :present},
                       :write :replace-root,
                       :mapping/ref :java/class,
                       :mapping/alternatives [:java/interface]}
                      {:from [:enum-class :enum-spec],
                       :operation :map-node,
                       :to [],
                       :when {:condition :present},
                       :write :replace-root,
                       :mapping/ref :java/enum}
                      {:from [:record-class :record-spec],
                       :operation :map-node,
                       :to [],
                       :when {:condition :present},
                       :write :replace-root,
                       :mapping/ref :java/record}
                      {:from [:annot-class],
                       :operation :map-node,
                       :to [],
                       :when {:condition :present},
                       :write :replace-root,
                       :mapping/ref :java/annotation-class}
                      {:from [:class-already-reflected],
                       :operation :resolve-class-reference,
                       :to [:ref],
                       :when {:condition :present}}],
                     :notes
                     ["Dispatch only present native branches. nil or {} from traversal indicates no emitted declaration."
                      "The annotation-class branch passes Class to a helper that expects Annotation; a thrown error is not a successful output shape and must not be fabricated into one."]}
           #:mapping{:id :java/class,
                     :input #:input{:kind :map},
                     :rules
                     [{:value :type-definition, :operation :constant, :to [:ast/tag]}
                      {:value :java, :operation :constant, :to [:ast/language]}
                      {:from [:class-name],
                       :operation :canonical-to-qualified-name,
                       :to [:ast/attributes :element/qualified-name]}
                      {:from [:class-name],
                       :operation :simple-class-name,
                       :to [:ast/attributes :element/name]}
                      {:from [:attributes],
                       :operation :decode-class-flags,
                       :to [:ast/attributes],
                       :write :merge}
                      {:from [:super-class],
                       :operation :dispatch-class,
                       :to [:ast/children],
                       :mapping/ref :java/class-wrapper,
                       :relation/role :extends-class,
                       :ownership :reference-not-child-owner,
                       :write :append}
                      {:from [:gen-super],
                       :operation :emit-supertype,
                       :to [:ast/attributes :type-definition/supertypes],
                       :relation/role :extends-class,
                       :write :merge-by-type}
                      {:from [:generics],
                       :operation :emit-type-parameters,
                       :to [:ast/children],
                       :mapping/ref :java/class-type-parameter,
                       :write :append}
                      {:from [:pinner-classes],
                       :operation :emit-nested-declarations,
                       :to [:ast/children],
                       :mapping/ref :java/class-wrapper,
                       :write :append}
                      {:from [:annotations],
                       :operation :normalize-annotations,
                       :to [:ast/attributes :element/annotations]}
                      {:from [:interfaces],
                       :operation :emit-interfaces,
                       :to [:ast/attributes :type-definition/supertypes],
                       :mapping/ref :java/class-wrapper,
                       :relation/role :implements,
                       :write :merge-by-type}
                      {:from [:gen-interfaces],
                       :operation :emit-interfaces,
                       :to [:ast/attributes :type-definition/supertypes],
                       :write :merge-by-type}
                      {:from [:enclosing-class],
                       :operation :normalize-type,
                       :to [:ast/attributes :type-definition/enclosing]}
                      {:from [:constructors],
                       :operation :map-nodes,
                       :to [:ast/children],
                       :mapping/ref :java/constructor,
                       :write :append}
                      {:from [:methods],
                       :operation :map-nodes,
                       :to [:ast/children],
                       :mapping/ref :java/method,
                       :write :append}
                      {:from [:fields],
                       :operation :map-nodes,
                       :to [:ast/children],
                       :mapping/ref :java/field,
                       :write :append}
                      {:from [:enum-specs],
                       :operation :freeze-native,
                       :to [:ast/native :java :enum-specs]}
                      {:from [:record-specs],
                       :operation :freeze-native,
                       :to [:ast/native :java :record-specs]}
                      {:from [], :operation :freeze-native, :to [:ast/native :java :class-payload]}
                      {:from [:class-name], :operation :class-id-from-output, :to [:ast/id]}],
                     :source "reflect_class.clj/get-all-class-attributes-and-values-internal",
                     :notes
                     ["All 15 keys of the emitted :normal-class map are consumed. No class modifiers or permitted-subclass list is present."
                      ":super-class and :interfaces contain other declarations or reference markers; their relationships do not imply lexical ownership."
                      ":pinner-classes is the actual native spelling and describes nested declarations, not subclasses."]}
           #:mapping{:id :java/interface,
                     :input #:input{:kind :map},
                     :rules
                     [{:value :contract, :operation :constant, :to [:ast/tag]}
                      {:value :java/interface,
                       :operation :constant,
                       :to [:ast/attributes :element/native-kind]}
                      {:from [],
                       :operation :map-node,
                       :to [],
                       :mapping/ref :java/class,
                       :write :merge-with-contract-tag,
                       :context/role :extends-interface}],
                     :select {:from [:attributes], :contains :attr-interface},
                     :notes
                     ["Interface definitions arrive under :normal-class with :attr-interface. Reuse class-field processing but emit :contract, convert parent interface edges to extends-interface and retain absent visibility as unavailable. The parent dispatcher must select this mapping before ordinary class emission."]}
           #:mapping{:id :java/class-reference,
                     :input #:input{:kind :map},
                     :rules
                     [{:from [:class-already-reflected],
                       :operation :resolve-class-reference,
                       :to [:ref]}]}
           #:mapping{:id :java/method,
                     :input #:input{:kind :map},
                     :rules
                     [{:value :callable, :operation :constant, :to [:ast/tag]}
                      {:value :java, :operation :constant, :to [:ast/language]}
                      {:value :method, :operation :constant, :to [:ast/attributes :callable/kind]}
                      {:from [:meth-name], :operation :copy, :to [:ast/attributes :element/name]}
                      {:from [:annotations],
                       :operation :normalize-annotations,
                       :to [:ast/attributes :element/annotations]}
                      {:from [:param-count],
                       :operation :copy,
                       :to [:ast/native :java :param-count]}
                      {:from [:modifiers],
                       :operation :decode-method-modifiers,
                       :to [:ast/attributes],
                       :write :merge}
                      {:from [:attribs],
                       :operation :decode-method-flags,
                       :to [:ast/jvm],
                       :write :merge}
                      {:from [:exception-types],
                       :operation :normalize-throws,
                       :to [:ast/native :java :java/throws]}
                      {:from [],
                       :operation :map-node,
                       :to [:ast/children],
                       :mapping/ref :java/method-signature,
                       :write :append}
                      {:from [],
                       :operation :freeze-native,
                       :to [:ast/native :java :executable-payload]}
                      {:from [], :operation :executable-id-from-output, :to [:ast/id]}],
                     :source "reflect_meths_ctors.clj",
                     :notes
                     ["Input is one element of :methods. Method identity uses owner context plus available erased parameter/return types. Use a source-path-local identity with explicit incompleteness if these are insufficient."
                      "The signature mapping joins parameter annotations once; type variables are emitted only from generic declaration structures retained in this output. No separate Method lookup is required."]}
           #:mapping{:id :java/constructor,
                     :input #:input{:kind :map},
                     :rules
                     [{:value :callable, :operation :constant, :to [:ast/tag]}
                      {:value :java, :operation :constant, :to [:ast/language]}
                      {:value :constructor,
                       :operation :constant,
                       :to [:ast/attributes :callable/kind]}
                      {:from [:ctor-name], :operation :copy, :to [:ast/attributes :element/name]}
                      {:from [:annotations],
                       :operation :normalize-annotations,
                       :to [:ast/attributes :element/annotations]}
                      {:from [:param-count],
                       :operation :copy,
                       :to [:ast/native :java :param-count]}
                      {:from [:modifiers],
                       :operation :decode-constructor-modifiers,
                       :to [:ast/attributes],
                       :write :merge}
                      {:from [:attribs],
                       :operation :decode-constructor-flags,
                       :to [:ast/jvm],
                       :write :merge}
                      {:from [:exception-types],
                       :operation :normalize-throws,
                       :to [:ast/native :java :java/throws]}
                      {:from [],
                       :operation :map-node,
                       :to [:ast/children],
                       :mapping/ref :java/constructor-signature,
                       :write :append}
                      {:from [],
                       :operation :freeze-native,
                       :to [:ast/native :java :executable-payload]}
                      {:from [], :operation :executable-id-from-output, :to [:ast/id]}],
                     :source "reflect_meths_ctors.clj",
                     :notes
                     ["Input is one element of :constructors. JVM name is <init>; :ctor-name supplies the native declared constructor name. Parameter identities use emitted order. No source return node is invented."]}
           #:mapping{:id :java/method-signature,
                     :input #:input{:kind :map},
                     :rules
                     [{:value :signature, :operation :constant, :to [:ast/tag]}
                      {:from [],
                       :operation :map-node,
                       :to [:ast/children],
                       :mapping/ref :java/parameter-list,
                       :write :append}
                      {:from [:return-types],
                       :operation :map-node,
                       :to [:ast/children],
                       :mapping/ref :java/return,
                       :write :append}]}
           #:mapping{:id :java/constructor-signature,
                     :input #:input{:kind :map},
                     :rules
                     [{:value :signature, :operation :constant, :to [:ast/tag]}
                      {:from [],
                       :operation :map-node,
                       :to [:ast/children],
                       :mapping/ref :java/parameter-list,
                       :write :append}],
                     :notes
                     ["A constructor signature has parameter lists and no source return declaration. Its constructed type is derived from the containing declaration, not a new native input field. Adjust your AST grammar to permit this."]}
           #:mapping{:id :java/parameter-list,
                     :input #:input{:kind :map},
                     :rules
                     [{:value :parameter-list, :operation :constant, :to [:ast/tag]}
                      {:value 0, :operation :constant, :to [:ast/attributes :parameter-list/index]}
                      {:value :ordinary,
                       :operation :constant,
                       :to [:ast/attributes :parameter-list/kind]}
                      {:from [:all-param-attribs],
                       :operation :map-nodes,
                       :to [:ast/children],
                       :mapping/ref :java/parameter,
                       :write :append}
                      {:from [:generic-param-types],
                       :operation :merge-parameter-generics,
                       :to [:ast/children],
                       :write :merge-by-index}
                      {:from [:param-annots],
                       :operation :join-parameter-annotations,
                       :to [:ast/children],
                       :write :merge-by-index}],
                     :notes
                     ["Use :all-param-attribs order. Merge :generic-param-types and :param-annots by index into the emitted parameters. Generic declaration structures already in those values may add scoped type-variable nodes to the owning callable; do not look up a Method separately."]}
           #:mapping{:id :java/parameter,
                     :input #:input{:kind :map},
                     :rules
                     [{:value :parameter, :operation :constant, :to [:ast/tag]}
                      {:value :value, :operation :constant, :to [:ast/attributes :parameter/role]}
                      {:from-context [:index],
                       :operation :copy,
                       :to [:ast/attributes :parameter/index]}
                      {:from [:param-name],
                       :operation :source-parameter-name,
                       :to [:ast/attributes :element/name]}
                      {:from [:param-name], :operation :copy, :to [:ast/jvm :jvm/name]}
                      {:from [:param-type],
                       :operation :normalize-type,
                       :to [:ast/jvm :jvm/erased-type]}
                      {:from [:param-parametrized-type],
                       :operation :normalize-type,
                       :to [:ast/attributes :parameter/type],
                       :priority 20}
                      {:from [:param-annot-type],
                       :operation :normalize-type,
                       :to [:ast/attributes :parameter/type],
                       :priority 30}
                      {:from [:param-annots],
                       :operation :normalize-annotations,
                       :to [:ast/attributes :element/annotations]}
                      {:from [:param-modifiers],
                       :operation :decode-parameter-modifiers,
                       :to [:ast/attributes],
                       :write :merge}
                      {:from [:param-flags],
                       :operation :decode-parameter-flags,
                       :to [:ast/attributes],
                       :write :merge}
                      {:from [],
                       :operation :freeze-native,
                       :to [:ast/native :java :parameter-payload]}]}
           #:mapping{:id :java/return,
                     :input #:input{:kind :map},
                     :rules
                     [{:value :return, :operation :constant, :to [:ast/tag]}
                      {:from [:return-type],
                       :operation :normalize-type,
