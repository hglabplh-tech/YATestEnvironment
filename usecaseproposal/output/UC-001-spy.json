                "product-id": "P-100",
                "quantity": 2,
                "unit-price-cents": 1000
              }
            ]
          ],
          "arguments": [
            "customer-A",
            [
              {
                "product-id": "P-100",
                "quantity": 2,
                "unit-price-cents": 1000
